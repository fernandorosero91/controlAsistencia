# =============================================================================
# Variables de entorno para el despliegue en Dokploy.
#
# Pegar este contenido en Dokploy > Environment del servicio y ajustar:
#   1. POSTGRES_PASSWORD  -> contrasena larga y aleatoria
#   2. JWT_SECRET         -> openssl rand -base64 48
#   3. BASE_URL_PUBLICA   -> el dominio publico, sin barra final
#   4. ADMIN_EMAIL / ADMIN_PASSWORD
#
# El archivo NO se sube al repositorio: solo se guarda en Dokploy.
# =============================================================================

# ---------------------------------------------------------------- proyecto
# Puerto del host al que se publica el frontend. Si Dokploy enruta un dominio
# al servicio web, este valor solo sirve para el acceso por IP.
WEB_PORT=8080
LOG_LEVEL=info

# ---------------------------------------------------------------- base de datos
POSTGRES_DB=seminario
POSTGRES_USER=app
POSTGRES_PASSWORD=CAMBIE-ESTA-CONTRASENA
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=2
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
CACHE_TTL_MS=3000

# ---------------------------------------------------------------- seguridad
# Generar con: openssl rand -base64 48
JWT_SECRET=CAMBIE-ESTE-SECRETO-POR-UNO-DE-AL-MENOS-64-CARACTERES
JWT_ACCESS_TTL_SEGUNDOS=900
JWT_REFRESH_TTL_SEGUNDOS=604800
# Con HTTPS (el caso normal en Dokploy) dejar en true.
# Poner en false solo si se publica por HTTP sin certificado.
COOKIE_SECURE=true
COOKIE_DOMAIN=
# Vacio = solo mismo origen (lo recomendado: el frontend y la API comparten dominio).
CORS_ORIGINS=

# ---------------------------------------------------------------- direccion publica
# Dominio real del despliegue. Se usa en los QR de verificacion de certificados.
BASE_URL_PUBLICA=https://asistencia.gestionxpress.app

# ---------------------------------------------------------------- limites
BODY_LIMIT_BYTES=1048576
UPLOAD_MAX_BYTES=10485760
# El limite de escaneo se aplica POR USUARIO autenticado (no por IP): en la sede
# todos los celulares salen por la misma direccion publica. 80 por minuto
# equivalen a unas cuarenta registraciones por minuto y por operador.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_VENTANA_SEGUNDOS=60
RATE_LIMIT_ESCANEO_MAX=80
RATE_LIMIT_ESCANEO_VENTANA_SEGUNDOS=60
RATE_LIMIT_VERIFICACION_MAX=20
RATE_LIMIT_VERIFICACION_VENTANA_SEGUNDOS=60
RATE_LIMIT_ADMIN_MAX=600
RATE_LIMIT_ADMIN_VENTANA_SEGUNDOS=60

# ---------------------------------------------------------------- datos iniciales
# Se usan una sola vez: la primera vez que arranca la API sobre una base vacia.
# Despues ya no se leen (un redespliegue no cambia contrasenas ni configuracion).
ADMIN_NOMBRE=Administrador del seminario
ADMIN_EMAIL=admin@gestionxpress.app
ADMIN_PASSWORD=CAMBIE-ESTA-CONTRASENA-DE-ADMIN
OPERADOR_PASSWORD=
ADMIN_OPERADORES=6
# 0 = no crear asistentes ficticios (siempre 0 en produccion).
SEED_ASISTENTES=0

# ---------------------------------------------------------------- evento
SEMINARIO_NOMBRE=IV Seminario de Ingenieria de Software
SEMINARIO_FECHA=2026-10-27
SEMINARIO_LUGAR=Camara de Comercio - Pasto
SEMINARIO_FACULTAD=Facultad de Ingenieria
SEMINARIO_CONTACTO=311 781 7327
SEMINARIO_INVERSION=$185.000
SEMINARIO_HORA_INICIO=08:00
SEMINARIO_HORA_FIN=18:00
SEMINARIO_TOLERANCIA_MINUTOS=15

# ---------------------------------------------------------------- correo (opcional)
# Sin SMTP_HOST el envio de QR por correo queda deshabilitado: usar la carta en PDF.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_SEGURIDAD=starttls
SMTP_REMITENTE=no-reply@gestionxpress.app
SMTP_REMITENTE_NOMBRE=IV Seminario de Ingenieria de Software
