# =============================================================================
# Variables de entorno del sistema de control de asistencia.
# Copie este archivo a .env y ajuste los valores. NUNCA suba el archivo .env.
# =============================================================================

# ---------------------------------------------------------------- general
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------- base de datos
POSTGRES_DB=seminario
POSTGRES_USER=app
POSTGRES_PASSWORD=seminario_dev
# Conexion directa a PostgreSQL (migraciones y herramientas)
DATABASE_URL=postgres://app:seminario_dev@localhost:5433/seminario
# Conexion a traves de PgBouncer (la que usa la API en produccion)
DATABASE_URL_PGBOUNCER=postgres://app:seminario_dev@localhost:6432/seminario
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=2
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS_REPORTES=15000

# ---------------------------------------------------------------- redis
# Sin Redis la API usa cache en memoria por proceso y el rate limit no se comparte.
REDIS_URL=redis://localhost:6379
CACHE_TTL_MS=3000

# ---------------------------------------------------------------- seguridad
# Genere con: openssl rand -base64 48
JWT_SECRET=cambie-este-secreto-por-uno-de-al-menos-32-caracteres
JWT_ACCESS_TTL_SEGUNDOS=900
JWT_REFRESH_TTL_SEGUNDOS=604800
COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080
BODY_LIMIT_BYTES=1048576
UPLOAD_MAX_BYTES=10485760

# ---------------------------------------------------------------- rates
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_VENTANA_SEGUNDOS=60
RATE_LIMIT_ESCANEO_MAX=600
RATE_LIMIT_ESCANEO_VENTANA_SEGUNDOS=60
RATE_LIMIT_VERIFICACION_MAX=20
RATE_LIMIT_VERIFICACION_VENTANA_SEGUNDOS=60
RATE_LIMIT_ADMIN_MAX=600
RATE_LIMIT_ADMIN_VENTANA_SEGUNDOS=60

# ---------------------------------------------------------------- aplicacion
BASE_URL_PUBLICA=http://localhost:8080
CERTIFICADOS_DIR=storage/certificados

# ---------------------------------------------------------------- seed
ADMIN_NOMBRE=Administrador del seminario
ADMIN_EMAIL=admin@seminario.local
ADMIN_PASSWORD=Seminario2026
OPERADOR_PASSWORD=
ADMIN_OPERADORES=2
SEED_ASISTENTES=600

# Base de datos aislada para las pruebas de integracion
DATABASE_URL_TEST=postgres://app:seminario_dev@localhost:5433/seminario_test
