# =============================================================================
# Variables de entorno del sistema de control de asistencia.
# Copie este archivo a .env y ajuste los valores. NUNCA suba el archivo .env.
# =============================================================================

# ---------------------------------------------------------------- general
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------- base de datos
POSTGRES_DB=seminario
POSTGRES_USER=app
POSTGRES_PASSWORD=seminario_dev
# Conexion directa a PostgreSQL (migraciones y herramientas)
DATABASE_URL=postgres://app:seminario_dev@localhost:5433/seminario
# Conexion a traves de PgBouncer (la que usa la API en produccion)
DATABASE_URL_PGBOUNCER=postgres://app:seminario_dev@localhost:6432/seminario
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=2
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS_REPORTES=15000

# ---------------------------------------------------------------- redis
# Sin Redis la API usa cache en memoria por proceso y el rate limit no se comparte.
REDIS_URL=redis://localhost:6379
CACHE_TTL_MS=3000

# ---------------------------------------------------------------- seguridad
# Genere con: openssl rand -base64 48
JWT_SECRET=cambie-este-secreto-por-uno-de-al-menos-32-caracteres
JWT_ACCESS_TTL_SEGUNDOS=900
JWT_REFRESH_TTL_SEGUNDOS=2592000
COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080
BODY_LIMIT_BYTES=1048576
UPLOAD_MAX_BYTES=10485760

# ---------------------------------------------------------------- rates
# El limite de escaneo se aplica POR USUARIO autenticado (no por IP): en la sede
# todos los celulares salen por la misma direccion publica. 80 por minuto
# equivalen a unas cuarenta registraciones por minuto y por operador.
RATE_LIMIT_LOGIN_MAX=30
RATE_LIMIT_LOGIN_VENTANA_SEGUNDOS=60
RATE_LIMIT_ESCANEO_MAX=150
RATE_LIMIT_ESCANEO_VENTANA_SEGUNDOS=60
RATE_LIMIT_VERIFICACION_MAX=20
RATE_LIMIT_VERIFICACION_VENTANA_SEGUNDOS=60
RATE_LIMIT_ADMIN_MAX=600
RATE_LIMIT_ADMIN_VENTANA_SEGUNDOS=60

# ---------------------------------------------------------------- aplicacion
BASE_URL_PUBLICA=http://localhost:8080
CERTIFICADOS_DIR=storage/certificados
PLANTILLAS_DIR=storage/plantillas
CERTIFICADOS_GENERADOS_DIR=storage/certificadosGenerados

# ---------------------------------------------------------------- seed
ADMIN_NOMBRE=Administrador del seminario
ADMIN_EMAIL=admin@seminario.local
ADMIN_PASSWORD=Seminario2026
OPERADOR_PASSWORD=
ADMIN_OPERADORES=2
SEED_ASISTENTES=600

# Permite borrar los datos operativos desde el panel, con la contrasena del
# administrador. Poner en false cuando la base ya tenga el padron real.
LIMPIAR_BASE_HABILITADO=true

# ---------------------------------------------------------------- datos del evento
# IV Seminario de Ingenieria de Software - Universidad Cooperativa de Colombia
SEMINARIO_NOMBRE=IV Seminario de Ingenieria de Software
SEMINARIO_FECHA=2026-10-27
SEMINARIO_LUGAR=Camara de Comercio - Pasto
SEMINARIO_FACULTAD=Facultad de Ingenieria
SEMINARIO_CONTACTO=311 781 7327
SEMINARIO_INVERSION=$185.000
SEMINARIO_HORA_INICIO=08:00
SEMINARIO_HORA_FIN=18:00
SEMINARIO_TOLERANCIA_MINUTOS=15

# ---------------------------------------------------------------- correo (QR por email)
# Sin SMTP_HOST el envio de QR por correo no esta disponible: use la carta de QR en PDF.
# Para Gmail: SMTP_PUERTO=587, SMTP_SEGURIDAD=starttls, SMTP_USUARIO=tu-cuenta@gmail.com,
# SMTP_CLAVE=contrasena-de-aplicacion (generada en Cuenta de Google > Seguridad > Contrasenas de aplicaciones).
# IMPORTANTE: con Gmail, SMTP_REMITENTE debe ser la misma cuenta que SMTP_USUARIO; de lo
# contrario el servidor rechaza el envio con "Sender address rejected".
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_SEGURIDAD=starttls
# Debe coincidir con SMTP_USUARIO cuando se usa Gmail u otro proveedor que exija autenticacion.
SMTP_REMITENTE=
SMTP_REMITENTE_NOMBRE=Seminario

# ---------------------------------------------------------------- base de datos aislada
DATABASE_URL_TEST=postgres://app:seminario_dev@localhost:5433/seminario_test

# Base de datos aislada para las pruebas de integracion
DATABASE_URL_TEST=postgres://app:seminario_dev@localhost:5433/seminario_test

# ---------------------------------------------------------------- envio de correos
# Los correos con la credencial se encolan con BullMQ sobre el mismo Redis del
# sistema: se procesan con concurrencia y ritmo limitados, con reintentos, y el
# panel muestra el avance. Sin SMTP o sin Redis el envio se hace en linea.
CORREOS_CONCURRENCIA=1
CORREOS_SEPARACION_SEGUNDOS=180
CORREOS_INTENTOS=3
