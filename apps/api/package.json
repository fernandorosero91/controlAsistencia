{
  "name": "@seminario/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API del sistema de control de asistencia, refrigerios y certificados",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration --no-file-parallelism",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:revert": "tsx src/db/migrate.ts down",
    "migrate:status": "tsx src/db/migrate.ts status",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.4",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.1",
    "@seminario/shared": "*",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.4",
    "csv-parse": "^5.6.0",
    "drizzle-orm": "^0.38.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
