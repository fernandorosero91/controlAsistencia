{
  "name": "@seminario/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aplicacion web: panel de administracion, app de operador y verificacion publica",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
